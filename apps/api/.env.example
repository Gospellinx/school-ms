DATABASE_URL=postgres://schoolms:schoolms@localhost:5432/schoolms
JWT_SECRET=change-me
PORT=3001
# Comma-separated list of web app origins allowed to call the API
WEB_ORIGIN=http://localhost:3000
# Link put in parent SMS messages (the parent portal web app)
PORTAL_URL=http://localhost:3000

# Paystack (fees). Use a test key (sk_test_...) until the school is live: no real money moves.
PAYSTACK_SECRET_KEY=
# Where Paystack sends the payer after checkout (a page that calls GET /api/parent/payments/:reference/verify)
PAYSTACK_CALLBACK_URL=http://localhost:3000/pay/done
# Who pays Paystack's charges on school subaccounts: subaccount (the school) or account (the platform)
PAYSTACK_FEE_BEARER=subaccount
# PAYSTACK_BASE_URL=https://api.paystack.co
# PAYSTACK_FALLBACK_EMAIL_DOMAIN=parents.linxschool.ng

# SMS and WhatsApp to parents through Termii. Leave the key empty to log messages instead of sending.
TERMII_API_KEY=
TERMII_SENDER_ID=LinxSchool
# Your account's base URL from the Termii dashboard
TERMII_BASE_URL=https://api.ng.termii.com
# MESSAGING_PROVIDER=termii|log
# How often queued messages are sent, in ms (0 turns the background sender off)
NOTIFICATIONS_POLL_MS=5000

# AI exam prep, explanations, question drafts and report comments (Claude API)
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
AI_DAILY_LIMIT_PER_STUDENT=30
